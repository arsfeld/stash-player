<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>one.arsfeld.stash-player</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Stash Player</name>
  <summary>Native Linux client for Stash</summary>

  <description>
    <p>
      Stash Player is a native GTK4 + libadwaita client for the
      Stash media server. Browse your library and play scenes locally
      with hardware-accelerated video.
    </p>
    <p>Features:</p>
    <ul>
      <li>Adaptive libadwaita UI that fits in on GNOME</li>
      <li>Local playback via GStreamer with VA-API where available</li>
      <li>Resume position and play count synced back to Stash</li>
    </ul>
  </description>

  <launchable type="desktop-id">one.arsfeld.stash-player.desktop</launchable>

  <url type="homepage">https://github.com/arsfeld/stash-player</url>
  <url type="bugtracker">https://github.com/arsfeld/stash-player/issues</url>

  <developer id="one.arsfeld">
    <name>Alexandre Rosenfeld</name>
  </developer>

  <content_rating type="oars-1.1"/>

  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Player</category>
  </categories>

  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </recommends>

  <requires>
    <display_length compare="ge">360</display_length>
    <internet>always</internet>
  </requires>

  <branding>
    <color type="primary" scheme_preference="light">#c5a8ff</color>
    <color type="primary" scheme_preference="dark">#3b1f6b</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-05-09">
      <description>
        <p>Initial release.</p>
        <ul>
          <li>Library browse with search, sort and filtering</li>
          <li>Inline scene player with mpv-style keyboard shortcuts</li>
          <li>Settings page with Stash URL and API key entry</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
